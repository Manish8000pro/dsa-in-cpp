//669. Maximum Element and its Frequency
class SegmentTree {
public:

    vector<vector<int>> tree;
    int n;

    // --------------------------------
    // Constructor
    // --------------------------------
    
    SegmentTree(vector<int>& arr) {

        n = arr.size();

        tree.resize(4 * n);

        build(0, 0, n - 1, arr);
    }


    // --------------------------------
    // Combine two nodes
    // --------------------------------
    vector<int> combine(vector<int> left,vector<int> right) {

        // Left maximum is greater
        if(left[0] > right[0]) {
            return left;
        }

        // Right maximum is greater
        if(right[0] > left[0]) {
            return right;
        }

        // Both maximums are equal
        return {
            left[0],left[1] + right[1]
        };
    }


    // --------------------------------
    // Build
    // --------------------------------
    void build(int node, int start, int end,vector<int>& arr) {

        // Leaf node
        if(start == end) {

            // {value, frequency}
            tree[node] = {arr[start], 1};

            return;
        }

        int mid = start + (end - start) / 2;

        // Build left child
        build(2 * node + 1,start,mid,arr);

        // Build right child
        build(2 * node + 2,mid + 1,end,arr);

        // Combine both children
        tree[node] = combine(tree[2 * node + 1],tree[2 * node + 2]);
    }


    // --------------------------------
    // Update
    // --------------------------------
    void update(int index, int val) {

        updateHelper(0,0,n - 1,index,val);
    }


    void updateHelper(int node,int start,int end,int index,int val) {

        // Reached the required index
        if(start == end) {

            tree[node] = {val, 1};

            return;
        }

        int mid = start + (end - start) / 2;

        // Go left
        if(index <= mid) {

            updateHelper(2 * node + 1,start,mid,index,val);
        }

        // Go right
        else {

            updateHelper( 2 * node + 2,mid + 1,end,index,val);
        }

        // Update current node
        tree[node] = combine(tree[2 * node + 1],tree[2 * node + 2]);
    }


    // --------------------------------
    // Query
    // --------------------------------
    vector<int> query(int left, int right) {

        return queryHelper(0,0,n - 1,left,right);
    }


    vector<int> queryHelper(int node,int start,int end,int left,int right) {

        // No overlap
        if(end < left || start > right) {

            // Identity:
            // maximum = INT_MIN
            // frequency = 0
            return {INT_MIN, 0};
        }


        // Complete overlap
        if(left <= start && end <= right) {

            return tree[node];
        }


        int mid = start + (end - start) / 2;

        // Query left child
        vector<int> leftAns = queryHelper(2 * node + 1,start,mid,left,right);

        // Query right child
        vector<int> rightAns = queryHelper(2 * node + 2,mid + 1,end,left,right);

        // Combine both answers
        return combine(leftAns, rightAns);
    }
};